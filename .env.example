# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend ---
TRACEX_ENV=development
TRACEX_DATABASE_URL=postgresql+psycopg2://tracex:tracex@db:5432/tracex
TRACEX_REDIS_URL=redis://redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TRACEX_JWT_SECRET=
TRACEX_JWT_EXPIRY_MINUTES=120

TRACEX_CORS_ORIGINS=http://localhost:3000
TRACEX_RATE_LIMIT_PER_MINUTE=60

# --- Optional: real EVM chain provider (leave blank to stay on mock/demo data) ---
TRACEX_EVM_RPC_URL=
TRACEX_EXPLORER_API_KEY=
TRACEX_EXPLORER_BASE_URL=https://api.etherscan.io/api

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Postgres (used by docker-compose to init the db container) ---
POSTGRES_USER=tracex
POSTGRES_PASSWORD=tracex
POSTGRES_DB=tracex
